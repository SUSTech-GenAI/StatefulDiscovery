# AMD64 rebuild of FutureHouse's pinned Aviary notebook environment.
#
# Reference:
# https://github.com/Future-House/aviary/blob/main/packages/notebook/docker/Dockerfile.pinned
#
# BUSCO is intentionally omitted here. The downstream StatefulDiscovery
# Dockerfiles install BUSCO consistently for both ARM64 and AMD64.

FROM continuumio/miniconda3:24.9.2-0

RUN mkdir /workspace && \
    mkdir /envs
WORKDIR /envs

ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && \
    apt-get install -yq --no-install-recommends \
        wget \
        gpg \
        software-properties-common \
        build-essential && \
    rm -rf /var/lib/apt/lists/*

RUN conda install mamba=2.0.5 -c conda-forge -y

# Install R packages from conda-forge.
RUN mamba install -c conda-forge -y \
    r-base=4.3.3 \
    r-recommended=4.3 \
    r-irkernel=1.3.2 \
    r-factominer=2.11 \
    r-rcolorbrewer=1.1_3 \
    r-devtools=2.4.5 \
    r-broom=1.0.7 \
    r-data.table=1.15.4 \
    r-enrichr=3.2 \
    r-factoextra=1.0.7 \
    r-ggnewscale=0.5.0 \
    r-ggrepel=0.9.6 \
    r-ggpubr=0.6.0 \
    r-ggvenn=0.1.10 \
    r-janitor=2.2.1 \
    r-multcomp=1.4_26 \
    r-matrix=1.6_5 \
    r-pheatmap=1.0.12 \
    r-tidyverse=2.0.0 \
    r-readxl=1.4.3 \
    r-reshape=0.8.9 \
    r-rstatix=0.7.2 \
    r-viridis=0.6.5 \
    udocker=1.3.17 \
    imbalanced-learn=0.13.0 \
    ipykernel=6.29.5

RUN python -m ipykernel install --user --name python3 --display-name "Python 3 (ipykernel)"
RUN R -e 'IRkernel::installspec(name = "R", displayname = "R (4.3.3)")'

# Separate channels and layers match the upstream pinned environment.
RUN mamba install -c conda-forge -c bioconda -y \
    biokit=0.5.0 \
    gseapy=1.1.4 \
    blast=2.16.0 \
    'sqlite>=3.49.1' \
    clipkit=2.3.0 \
    fastqc=0.12.1 \
    iqtree=2.3.6 \
    mafft=7.526 \
    metaeuk=7.bba0d80 \
    mygene=3.2.2 \
    perl=5.32.1 \
    phykit=2.0.1 \
    pydeseq2=0.4.12 \
    spades=4.0.0 \
    trim-galore=0.6.10 \
    bioconductor-enhancedvolcano=1.20.0 \
    bioconductor-deseq2=1.42.0 \
    bioconductor-clusterprofiler=4.10.0 \
    bioconductor-org.hs.eg.db=3.18.0 \
    bioconductor-genomicranges=1.54.1 \
    bioconductor-summarizedexperiment=1.32.0 \
    bioconductor-apeglm=1.24.0

# FutureHouse's pinned Python packages. Keep them explicit so the active
# package group is visible in Docker build logs.
RUN mamba install -c conda-forge -y \
    anndata==0.11.1 \
    biopython==1.84 \
    ete3==3.1.3 \
    gseapy==1.1.4 \
    matplotlib==3.10.0 \
    matplotlib-venn==1.1.1 \
    mygene==3.2.2 \
    nbconvert==7.16.4 \
    numpy==2.0.2 \
    optuna==4.1.0 \
    openpyxl==3.1.5 \
    pandas==2.2.3 \
    plotly==5.24.1 \
    rpy2==3.5.11 \
    scipy==1.14.1 \
    seaborn==0.13.2 \
    scikit-learn==1.6.0 \
    statsmodels==0.14.4

RUN mamba install -c conda-forge -y \
    scanpy==1.10.4 \
    umap-learn==0.5.7

RUN mamba install -c conda-forge -y \
    jupyter==1.0.0 \
    keras==3.7.0 \
    pytorch==2.5.1

WORKDIR /workspace

RUN mamba clean --all -f -y && \
    conda clean --all -f -y && \
    rm -rf /root/.cache/pip

CMD ["bash"]

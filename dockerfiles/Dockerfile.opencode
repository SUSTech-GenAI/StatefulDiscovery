FROM futurehouse/bixbench:aviary-notebook-env

# Install Node.js for OpenCode CLI
RUN apt-get update && \
    apt-get install -y --no-install-recommends curl ca-certificates && \
    curl -fsSL https://deb.nodesource.com/setup_20.x | bash - && \
    apt-get install -y --no-install-recommends nodejs && \
    apt-get clean && rm -rf /var/lib/apt/lists/*

# Install OpenCode CLI
ARG OPENCODE_VERSION=1.2.26
RUN npm config set registry https://registry.npmmirror.com && \
    npm install -g opencode-ai@${OPENCODE_VERSION}

# Install bioinformatics tools
ARG http_proxy
ARG https_proxy
RUN conda config --set proxy_servers.http "${http_proxy:-}" 2>/dev/null; \
    conda config --set proxy_servers.https "${https_proxy:-}" 2>/dev/null; \
    conda install -y -c bioconda -c conda-forge bwa samtools bcftools pysam && \
    conda create -n busco_env -y -c bioconda -c conda-forge busco && \
    echo '#!/bin/bash' > /opt/conda/bin/busco && \
    echo 'exec /opt/conda/bin/conda run -n busco_env busco "$@"' >> /opt/conda/bin/busco && \
    chmod +x /opt/conda/bin/busco && \
    conda clean -afy

# Create non-root user (default 1000, override with --build-arg)
ARG HOST_UID=1000
RUN useradd -m -s /bin/bash -u ${HOST_UID} agent

WORKDIR /workspace

# Container AGENTS.md -> workspace root (auto-loaded by OpenCode)
COPY container/opencode/AGENTS.md /workspace/AGENTS.md

# OpenCode skills and subagents -> project-local .opencode config
COPY --chown=agent:agent opencode_skills /workspace/.opencode/skills
COPY --chown=agent:agent opencode_agents /workspace/.opencode/agents

# Run and log directories will be mounted at /workspace/run and /workspace/log
RUN mkdir -p /workspace/run /workspace/log && chown -R agent:agent /workspace

USER agent

CMD ["bash"]
